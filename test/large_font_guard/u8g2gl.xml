<?xml version="1.0" encoding="UTF-8"?>
<!-- The large-font guard fixture (design_spec §14.1).

     U8G2 compiles its fonts over 32 KB only where U8G2_USE_LARGE_FONTS is
     defined (u8g2.h), so the generator guards each large <builtin> with an
     #error. Its generated/ui_fonts.cpp is committed and compiled by
     test/CMakeLists.txt twice: without the macro it must fail naming the font,
     and with it, it must compile. cli/test/generator/emit-large-fonts.test.ts
     fails if regenerating this project changes a committed byte. Refresh
     deliberately with cli/test/generator/refresh-goldens.mjs. -->
<u8g2gl schema="0.7" name="large_font_guard" version="1.0.0">
    <targets>
        <target name="host" setup="U8G2_SSD1306_128X64_NONAME_F_HW_I2C" rotation="R0" />
    </targets>
    <output dir="generated" />
</u8g2gl>
