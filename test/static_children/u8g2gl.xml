<!-- The static-children fixture (design_spec §6.5).

     A service list whose columns are written as <column> children, so the
     generator calls add_column() at construction. Its generated/ directory is
     committed and compiled by test/CMakeLists.txt with the departures fixture's
     own wd_service_list C++ (test_static_children.cpp), which checks the
     generated list lays out as one configured by hand-written add_column()
     calls. cli/test/generator/static-children-fixture.test.ts fails if
     regenerating this project changes a committed byte, or if the manifest
     below stops matching the departures fixture's. Refresh deliberately with
     cli/test/generator/refresh-goldens.mjs.

     The target is 128x64, the display the host U8G2 stub reports. -->
<u8g2gl schema="0.7" name="static_children" version="1.0.0">
    <targets>
        <target name="host" setup="U8G2_SSD1306_128X64_NONAME_F_HW_I2C" rotation="R0" />
    </targets>
    <output dir="generated" />
</u8g2gl>
