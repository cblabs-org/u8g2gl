<?xml version="1.0" encoding="UTF-8"?>
<!--
  U8G2GL Expressiveness Probe — G-PROBE Work Order 1
  File: tmp/g-probe/departures_workaround.xml
  Description: Hand-expanded workaround representation of layoutSWR.json.
  
  LABELLED WORKAROUND:
  This file explicitly contains static unrolling / hand-expansions to bridge
  expressiveness gaps in Schema 0.4 where declarative collection repetition
  [Q-8] or dynamic cards/carousels [Q-15] are missing.

  Includes:
    - All static elements from departures_static.xml
    - Hand-expanded row0Widget: Service 1 (time, destination, status)
    - Hand-expanded msgWidget: Single circular scrolling label for primary message
    - Hand-expanded formationWidget: 12 static carriage boxes with numbers (amenities omitted)
    - Hand-expanded servicesWidget: Services 2-4 (Service 2 active; Services 3 & 4 hidden)
-->
<screen name="departures_workaround">
    <styles>
        <style name="plat_text" font="u8g2_font_6x10_mr" align="center" />
        <style name="plat_num" font="u8g2_font_helvR08_tr" align="center" />
        <style name="clock_style" font="u8g2_font_helvR08_tr" align="right" />
        <style name="row0_font" font="u8g2_font_6x10_mr" align="left" />
        <style name="row0_font_right" font="u8g2_font_6x10_mr" align="right" />
        <style name="msg_font" font="u8g2_font_6x10_mr" align="left" />
        <style name="coach_font" font="font_4x6" align="center" />
        <style name="sub_font" font="font_4x6" align="left" />
        <style name="sub_font_center" font="font_4x6" align="center" />
        <style name="sub_font_right" font="font_4x6" align="right" />
    </styles>

    <view>
        <!-- =================================================================== -->
        <!-- 1. Static Platform Header & Primitives                              -->
        <!-- =================================================================== -->
        <!-- Left platform header box (x=0, y=0, w=28, h=51, unfilled) -->
        <u8g2gl_box name="plat_box" x="0" y="0" width="28" height="51" filled="false" radius="0" />

        <!-- Static text "Plat" (x=5, y=6, w=18, h=13) -->
        <u8g2gl_label name="plat_label" x="5" y="6" width="18" height="13"
                      style="plat_text" text="Plat" />

        <!-- platformWidget: Platform indicator (x=4, y=20, w=20, h=24) -->
        <u8g2gl_label name="plat_num" x="4" y="20" width="20" height="24"
                      style="plat_num" text="9" bind_text="platform" />

        <!-- Horizontal separator line (x1=30, y1=50, x2=256, y2=50) -->
        <u8g2gl_line name="header_sep" x1="30" y1="50" x2="256" y2="50" />

        <!-- sysClock: System Clock (x=190, y=51, w=66, h=16) -->
        <u8g2gl_clock name="sys_clock" x="190" y="51" width="66" height="16"
                      style="clock_style" secondary_font="font_4x6"
                      format="hh_mm_ss" blink="false" bind_time="system_time" />

        <!-- noDataLabel: "No services found." fallback label (hidden by default) -->
        <u8g2gl_label name="no_data_label" x="32" y="17" width="224" height="14"
                      style="msg_font" text="No services found." hidden="true" />

        <!-- =================================================================== -->
        <!-- 2. Workaround: row0Widget (Service 1 Columns Hand-Expanded)         -->
        <!-- =================================================================== -->
        <u8g2gl_label name="row0_time" x="32" y="0" width="34" height="16"
                      style="row0_font" text="19:55" bind_text="row0_time" />
        <u8g2gl_label name="row0_dest" x="66" y="0" width="126" height="16"
                      style="row0_font" text="London Paddington" bind_text="row0_dest" />
        <u8g2gl_label name="row0_status" x="194" y="0" width="60" height="16"
                      style="row0_font_right" text="On time" bind_text="row0_status" />

        <!-- =================================================================== -->
        <!-- 3. Workaround: msgWidget (Single Circular Scrolling Label)          -->
        <!-- =================================================================== -->
        <u8g2gl_label name="msg_scroller" x="32" y="17" width="224" height="14"
                      style="msg_font" long_mode="scroll_circular"
                      text="A reduced train service will be running to and from London Waterloo from Good Friday 3 April to Easter Monday 6 April inclusive."
                      bind_text="msg_text" />

        <!-- =================================================================== -->
        <!-- 4. Workaround: formationWidget (12 Hand-Expanded Carriage Boxes)    -->
        <!-- =================================================================== -->
        <!-- Coach 1 -->
        <u8g2gl_box name="coach_box_1" x="34" y="34" width="16" height="12" filled="false" />
        <u8g2gl_label name="coach_lbl_1" x="35" y="35" width="14" height="10" style="coach_font" text="1" />

        <!-- Coach 2 -->
        <u8g2gl_box name="coach_box_2" x="52" y="34" width="16" height="12" filled="false" />
        <u8g2gl_label name="coach_lbl_2" x="53" y="35" width="14" height="10" style="coach_font" text="2" />

        <!-- Coach 3 -->
        <u8g2gl_box name="coach_box_3" x="70" y="34" width="16" height="12" filled="false" />
        <u8g2gl_label name="coach_lbl_3" x="71" y="35" width="14" height="10" style="coach_font" text="3" />

        <!-- Coach 4 -->
        <u8g2gl_box name="coach_box_4" x="88" y="34" width="16" height="12" filled="false" />
        <u8g2gl_label name="coach_lbl_4" x="89" y="35" width="14" height="10" style="coach_font" text="4" />

        <!-- Coach 5 -->
        <u8g2gl_box name="coach_box_5" x="106" y="34" width="16" height="12" filled="false" />
        <u8g2gl_label name="coach_lbl_5" x="107" y="35" width="14" height="10" style="coach_font" text="5" />

        <!-- Coach 6 -->
        <u8g2gl_box name="coach_box_6" x="124" y="34" width="16" height="12" filled="false" />
        <u8g2gl_label name="coach_lbl_6" x="125" y="35" width="14" height="10" style="coach_font" text="6" />

        <!-- Coach 7 -->
        <u8g2gl_box name="coach_box_7" x="142" y="34" width="16" height="12" filled="false" />
        <u8g2gl_label name="coach_lbl_7" x="143" y="35" width="14" height="10" style="coach_font" text="7" />

        <!-- Coach 8 -->
        <u8g2gl_box name="coach_box_8" x="160" y="34" width="16" height="12" filled="false" />
        <u8g2gl_label name="coach_lbl_8" x="161" y="35" width="14" height="10" style="coach_font" text="8" />

        <!-- Coach 9 -->
        <u8g2gl_box name="coach_box_9" x="178" y="34" width="16" height="12" filled="false" />
        <u8g2gl_label name="coach_lbl_9" x="179" y="35" width="14" height="10" style="coach_font" text="9" />

        <!-- Coach 10 -->
        <u8g2gl_box name="coach_box_10" x="196" y="34" width="16" height="12" filled="false" />
        <u8g2gl_label name="coach_lbl_10" x="197" y="35" width="14" height="10" style="coach_font" text="10" />

        <!-- Coach 11 -->
        <u8g2gl_box name="coach_box_11" x="214" y="34" width="16" height="12" filled="false" />
        <u8g2gl_label name="coach_lbl_11" x="215" y="35" width="14" height="10" style="coach_font" text="11" />

        <!-- Coach 12 -->
        <u8g2gl_box name="coach_box_12" x="232" y="34" width="16" height="12" filled="false" />
        <u8g2gl_label name="coach_lbl_12" x="233" y="35" width="14" height="10" style="coach_font" text="12" />

        <!-- =================================================================== -->
        <!-- 5. Workaround: servicesWidget (Subsequent Services Hand-Expanded)   -->
        <!-- =================================================================== -->
        <!-- Service 2: Visible by default (x=0, y=54, w=190, h=10) -->
        <u8g2gl_label name="row1_ordinal" x="0" y="54" width="32" height="10"
                      style="sub_font_center" text="2nd" bind_text="row1_ordinal" />
        <u8g2gl_label name="row1_time" x="32" y="54" width="30" height="10"
                      style="sub_font" text="19:38" bind_text="row1_time" />
        <u8g2gl_label name="row1_dest" x="62" y="54" width="70" height="10"
                      style="sub_font" text="London Victoria" bind_text="row1_dest" />
        <u8g2gl_label name="row1_status" x="132" y="54" width="50" height="10"
                      style="sub_font_right" text="19:41" bind_text="row1_status" />

        <!-- Service 3: Hidden by default (alternate carousel card) -->
        <u8g2gl_label name="row2_ordinal" x="0" y="54" width="32" height="10"
                      style="sub_font_center" text="3rd" bind_text="row2_ordinal" hidden="true" />
        <u8g2gl_label name="row2_time" x="32" y="54" width="30" height="10"
                      style="sub_font" text="--:--" bind_text="row2_time" hidden="true" />
        <u8g2gl_label name="row2_dest" x="62" y="54" width="70" height="10"
                      style="sub_font" text="Clapham Junction" bind_text="row2_dest" hidden="true" />
        <u8g2gl_label name="row2_status" x="132" y="54" width="50" height="10"
                      style="sub_font_right" text="Delayed" bind_text="row2_status" hidden="true" />

        <!-- Service 4: Hidden by default (alternate carousel card) -->
        <u8g2gl_label name="row3_ordinal" x="0" y="54" width="32" height="10"
                      style="sub_font_center" text="4th" bind_text="row3_ordinal" hidden="true" />
        <u8g2gl_label name="row3_time" x="32" y="54" width="30" height="10"
                      style="sub_font" text="19:39" bind_text="row3_time" hidden="true" />
        <u8g2gl_label name="row3_dest" x="62" y="54" width="70" height="10"
                      style="sub_font" text="Epsom Downs" bind_text="row3_dest" hidden="true" />
        <u8g2gl_label name="row3_status" x="132" y="54" width="50" height="10"
                      style="sub_font_right" text="On time" bind_text="row3_status" hidden="true" />
    </view>
</screen>
