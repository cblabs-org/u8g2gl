<?xml version="1.0" encoding="UTF-8"?>
<globals>
    <consts>
        <int name="layout_width" value="128" />
        <int name="layout_height" value="64" />
    </consts>

    <subjects>
        <string name="station_name" value="London Euston" max_len="48" />
        <bool name="wifi_connected" value="true" />
        <int name="temperature" value="21" />
    </subjects>

    <styles>
        <style name="header" font="small_9" align="center" draw_color="1" />
        <style name="body" font="small_9" align="left" draw_color="1" />
    </styles>

    <!-- fonts/4x6.bdf is U8G2's own tools/font/bdf/4x6.bdf (public domain), the
         PR-04b WO2 correctness oracle — the same BDF two <bdf> declarations
         compile with different ranges (PR-04b WO3). -->
    <fonts>
        <bdf name="small_9" src="fonts/4x6.bdf" range="0x20-0x7F" />
        <bdf name="tall_12" src="fonts/4x6.bdf" range="0x30-0x39" />
    </fonts>

    <images>
        <xbm name="icon_wifi" src="images/wifi.xbm" />
    </images>
</globals>
