<!-- U8G2GL Project Descriptor Fixture per design_spec §5.1 -->
<u8g2gl schema="0.5" name="departures-board" version="1.0">
    <targets>
        <!-- setup names a U8G2 full-buffer constructor; geometry is derived -->
        <target name="default" default="true" ram_budget="4800">
            <display setup="U8G2_SSD1322_NHD_256X64_F_4W_HW_SPI" rotation="0" />
            <bus cs="10" dc="9" reset="8" />
        </target>
        <target name="compact">
            <display setup="U8G2_SSD1306_128X64_NONAME_F_HW_I2C" address="0x3C" />
        </target>
    </targets>

    <!-- Optional: generation settings -->
    <output dir="generated" prefix="ui_" />
</u8g2gl>
