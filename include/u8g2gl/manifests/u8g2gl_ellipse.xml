<?xml version="1.0" encoding="UTF-8"?>
<widget name="u8g2gl_ellipse">
  <api label="Ellipse" category="Drawing" description="An ellipse, outlined or filled, whole or in quarters.">
    <prop name="x" type="int" draw="u8g2gl_draw_ellipse" help="Center X coordinate" />
    <prop name="y" type="int" draw="u8g2gl_draw_ellipse" help="Center Y coordinate" />
    <prop name="rx" type="int" draw="u8g2gl_draw_ellipse" required="true" help="Horizontal radius in pixels" />
    <prop name="ry" type="int" draw="u8g2gl_draw_ellipse" required="true" help="Vertical radius in pixels" />
    <prop name="filled" type="bool" draw="u8g2gl_draw_ellipse" default="false" help="Whether ellipse is filled" />
    <prop name="segments" type="enum" draw="u8g2gl_draw_ellipse" values="all,upper_left,upper_right,lower_left,lower_right" default="all" emit="U8G2GL_DRAW_SEGMENT_{VALUE^^}" help="Ellipse segments to draw" />
    <bind name="bind_x" type="int" setter="x" />
    <bind name="bind_y" type="int" setter="y" />
  </api>
</widget>
