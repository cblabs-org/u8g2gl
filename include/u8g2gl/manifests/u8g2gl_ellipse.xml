<?xml version="1.0" encoding="UTF-8"?>
<widget name="u8g2gl_ellipse" animated="false">
  <api>
    <prop name="x" type="int" setter="drawEllipse" required="true" help="Center X coordinate" />
    <prop name="y" type="int" setter="drawEllipse" required="true" help="Center Y coordinate" />
    <prop name="rx" type="int" setter="drawEllipse" required="true" help="Horizontal radius in pixels" />
    <prop name="ry" type="int" setter="drawEllipse" required="true" help="Vertical radius in pixels" />
    <prop name="filled" type="bool" setter="drawFilledEllipse" default="false" help="Whether ellipse is filled" />
    <prop name="segments" type="enum" setter="drawEllipse" values="all,upper_left,upper_right,lower_left,lower_right" default="all" help="Ellipse segments to draw" />
  </api>
</widget>
