cmake_install.cmake
compile_commands.json
Testing/
*.o
*.a
*.so
*.dylib
*.dSYM/

# ─── Node / TypeScript (CLI + designer, PR-02/PR-04, Phase 3) ─────────────
node_modules/
dist/
cli/node_modules/
cli/dist/
.vite/
