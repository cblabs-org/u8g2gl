!assets/**/*.wasm

# ─── Generated output ──────────────────────────────────────────────────────
# Note: in a CONSUMING project, generated/ is committed on purpose ([D-11]).
# In THIS repo it only ever appears as test fixtures' scratch output.
/generated/
**/__generated__/

# ─── Editor / OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
!.vscode/extensions.json

# ─── Agent harness ─────────────────────────────────────────────────────────
# .claude is a local symlink to .agents; the real content is tracked there.
.claude

# Written by the PlatformIO MCP tooling when it attaches to this directory.
# Machine-local: it records that host's approval policy, not the project's.
.pio-mcp-policy.json

# ─── Scratch ───────────────────────────────────────────────────────────────
tmp/
*.log
