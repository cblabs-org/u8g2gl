{
  "name": "u8g2gl-designer",
  "version": "0.1.0",
  "private": true,
  "description": "The U8G2GL designer: the browser application u8g2gl design serves",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test:unit": "playwright test --config playwright.unit.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "dockview-react": "8.5.1",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
